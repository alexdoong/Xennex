<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AssemblyName>Xennex</AssemblyName>
    <Version>0.2.4</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <Company>Alex Doong</Company>
    <Authors>Alex Doong</Authors>
    <Product>Xennex</Product>
    <Description>Xennex HUD and Gaming Companion App</Description>
    <Copyright>Copyright © 2026 Alex Doong</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Backup\**" />
    <Compile Remove="scripts\**" />
    <Compile Remove="src\CaptureWorker\**" />
    <Compile Remove="src\Android\**" />
    <EmbeddedResource Remove="src\Android\**" />
    <None Remove="src\Android\**" />
    <EmbeddedResource Remove="Backup\**" />
    <None Remove="Backup\**" />
  </ItemGroup>



  <ItemGroup>
    <InternalsVisibleTo Include="VrTests" />
    <None Update="src/Interop/Vr/Valve/LICENSE.txt" Link="licenses/OpenVR.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="scripts\alice_memory\**\*.py;scripts\requirements-alice-memory.txt;scripts\requirements-alice-perception.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="scripts\hand_motion.py;scripts\gestures\**\*.py;scripts\requirements-gestures.txt;scripts\setup_gestures.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="REAL.exe" Condition="Exists('REAL.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <None Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="src\Services\Updates\install_update.ps1" LogicalName="Xennex.InstallUpdate.ps1" />
    <EmbeddedResource Include="scripts/lib/AuthenticodeVerification.cs" LogicalName="Xennex.AuthenticodeVerification.cs" />
    <EmbeddedResource Include="assets/publisher-thumbprint.txt" LogicalName="Xennex.PublisherThumbprint" />
    <EmbeddedResource Include="src/Interop/Vr/Valve/LICENSE.txt" LogicalName="Xennex.OpenVR.License" />
  </ItemGroup>
</Project>
