<Window x:Class="Xennex.UI.StreamViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Xennex Stream Viewer" Height="580" Width="960" MinHeight="360" MinWidth="480"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="#0B0E14" Foreground="#E2E8F0">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#0B0E14">
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Dark Glass Titlebar -->
        <Border Grid.Row="0" Background="#111622" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon & Stream Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtTitle" Text="Xennex Stream" Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" CornerRadius="4" Margin="10,0,0,0" Padding="6,2">
                        <TextBlock x:Name="TxtRoomBadge" Text="P2P LIVE" Foreground="#38BDF8" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Window Dragging Area (middle) -->
                <Rectangle Grid.Column="1" Fill="Transparent"/>

                <!-- Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnPin" ToolTip="Fixar no Topo (Always on Top)" Width="40" Height="38" Click="BtnPin_Click">
                        <TextBlock x:Name="IconPin" Text="📌" FontSize="12" Foreground="#94A3B8"/>
                    </Button>
                    <Button x:Name="BtnMinimize" ToolTip="Minimizar" Width="40" Height="38" Click="BtnMinimize_Click">
                        <TextBlock Text="🗕" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnMaximize" ToolTip="Maximizar / Restaurar" Width="40" Height="38" Click="BtnMaximize_Click">
                        <TextBlock x:Name="TxtMaxIcon" Text="🗖" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnClose" ToolTip="Fechar Janela" Width="44" Height="38" Style="{StaticResource CloseBtnStyle}" Click="BtnClose_Click">
                        <TextBlock Text="✕" FontSize="13" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 for Stream Content -->
        <wv2:WebView2 Grid.Row="1" x:Name="webView" DefaultBackgroundColor="#0B0E14"/>
    </Grid>
</Window>
