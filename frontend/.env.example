# Public build settings; use the same values for app and browser.
# Defaults to the public PeerJS signaling service.
# VITE_PEER_HOST=signal.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/peerjs
# VITE_PEER_SECURE=true
# Use dedicated TURN credentials, preferably short-lived. Never use an account API key.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turns:turn.example.com:443","username":"temporary-user","credential":"temporary-password"}]
# Optional broker URL; only requested after a participant explicitly chooses the alternative.
# Default: /api/turn-credentials on the public site (app uses its configured Cloudflare URL).
# Leave VITE_ICE_SERVERS unset for the default direct-first, opt-in behavior.
# VITE_TURN_ENDPOINT=https://xennex-live.example.workers.dev/api/turn-credentials
# Never put TURN_KEY_API_TOKEN or the private access code in Vite settings.
